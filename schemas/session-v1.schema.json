{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aplexer.local/schema/session-v1.json",
  "title": "aplexer session record v1",
  "description": "The PERSISTED on-disk session record (session.json). `a list --json`, `a snapshot`, and `a status --json` return this object plus fields derived at query time and never written to disk: `worker_alive`, `state`, and `agent` (which agent is running in the workload's live process tree -- see spec.md section 18). Those derived fields are deliberately absent from this schema because `additionalProperties: false` here describes exactly what a session record file may contain.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "workspace",
    "tag",
    "engine",
    "command",
    "cwd",
    "limits",
    "history_bytes",
    "created_at_ms",
    "updated_at_ms",
    "phase",
    "socket_path",
    "history_path"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "workspace": {
      "type": "string"
    },
    "tag": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "engine": {
      "type": "string"
    },
    "profile": {
      "type": [
        "string",
        "null"
      ]
    },
    "command": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "cwd": {
      "type": "string"
    },
    "env": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "env_unset": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limits": {
      "type": "object"
    },
    "history_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "created_at_ms": {
      "type": "integer"
    },
    "updated_at_ms": {
      "type": "integer"
    },
    "last_activity_ms": {
      "type": ["integer", "null"]
    },
    "last_accessed_ms": {
      "type": ["integer", "null"]
    },
    "phase": {
      "enum": [
        "starting",
        "running",
        "exiting",
        "exited",
        "failed"
      ]
    },
    "worker_pid": {
      "type": [
        "integer",
        "null"
      ]
    },
    "workload_pid": {
      "type": [
        "integer",
        "null"
      ]
    },
    "containment_cgroup": {
      "type": [
        "string",
        "null"
      ]
    },
    "containment_cgroup_identity": {
      "type": ["object", "null"],
      "required": [
        "boot_id",
        "cgroup_namespace_device",
        "cgroup_namespace_inode",
        "mount_namespace_device",
        "mount_namespace_inode",
        "cgroup_mount_id",
        "cgroup_root_device",
        "cgroup_root_inode"
      ],
      "properties": {
        "boot_id": {"type": "string", "minLength": 1},
        "cgroup_namespace_device": {"type": "integer", "minimum": 0},
        "cgroup_namespace_inode": {"type": "integer", "minimum": 1},
        "mount_namespace_device": {"type": "integer", "minimum": 0},
        "mount_namespace_inode": {"type": "integer", "minimum": 1},
        "cgroup_mount_id": {"type": "integer", "minimum": 1},
        "cgroup_root_device": {"type": "integer", "minimum": 0},
        "cgroup_root_inode": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "containment_empty": {
      "type": "boolean"
    },
    "socket_path": {
      "type": "string"
    },
    "history_path": {
      "type": "string"
    },
    "exit": {
      "type": [
        "object",
        "null"
      ]
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "parent_session": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "reported_state": {
      "type": [
        "string",
        "null"
      ]
    },
    "reported_state_at_ms": {
      "type": [
        "number",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
